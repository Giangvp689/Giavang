rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Tiệm vàng Đức Kỳ - Realtime sync for TV display, Mobile Admin, and Settings
    match /store_configs/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Aggregated real-time market gold rates
    match /market_rates/{rateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
